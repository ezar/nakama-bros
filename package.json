{
  "name": "nakama-bros",
  "version": "1.0.0",
  "private": true,
  "description": "Un plataformas 2D con la tripulación del Sombrero de Paja. Proyecto de fans; todo el arte se genera por código.",
  "license": "MIT",
  "author": "ezar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ezar/nakama-bros.git"
  },
  "homepage": "https://ezar.github.io/nakama-bros/",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "capture": "npm run build:capture && node scripts/shoot.mjs",
    "promo": "npm run build:capture && node scripts/promo.mjs",
    "icons": "node scripts/icons.mjs",
    "build:capture": "tsc && vite build --mode capture",
    "lint": "oxlint"
  },
  "dependencies": {
    "framer-motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
